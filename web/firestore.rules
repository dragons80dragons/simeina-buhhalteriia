rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Доступ лише до даних сім'ї з довгим секретним ідентифікатором із посилання.
    match /families/{fid}/months/{month} {
      allow list: if fid.size() >= 24;
      allow get, write: if fid.size() >= 24
        && month.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$');
    }
    // Вхідні сповіщення банку від MacroDroid (обробляє застосунок і видаляє)
    match /families/{fid}/inbox/{id} {
      allow create: if fid.size() >= 24
        && request.resource.data.keys().hasOnly(['who', 'at', 'text'])
        && request.resource.data.text is string && request.resource.data.text.size() < 2000;
      allow list, get, delete: if fid.size() >= 24;
      // застосунок «застовплює» сповіщення, щоб його обробив лише один телефон
      allow update: if fid.size() >= 24
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claim']);
    }
    match /families/{fid}/lists/{list} {
      allow get, write: if fid.size() >= 24 && list == 'main';
    }
  }
}
